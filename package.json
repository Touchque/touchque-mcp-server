{
  "name": "@touchque/mcp-server",
  "version": "3.0.0",
  "description": "MCP server for TouchQue — gives AI coding assistants accurate, up-to-date TouchQue SDK docs, types and an integration validator, and lets an AI agent with its own TouchQue identity ask a person to approve an action on their phone.",
  "main": "index.js",
  "bin": {
    "touchque-mcp-server": "index.js"
  },
  "files": [
    "index.js",
    "agent.js",
    "bundled",
    "manifest.json"
  ],
  "scripts": {
    "start": "node index.js",
    "test": "node --test index.test.js",
    "pack:mcpb": "node scripts/pack-mcpb.js"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "touchque",
    "2fa",
    "claude",
    "ai-agent",
    "human-in-the-loop",
    "approval"
  ],
  "author": "TouchQue",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Touchque/touchque-mcp-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2"
  }
}
