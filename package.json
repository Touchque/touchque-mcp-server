    "model-context-protocol",
    "touchque",
    "2fa",
    "claude",
    "ai-agent"
  ],
  "author": "TouchQue",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Touchque/touchque-mcp-server"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0"
  }
