  "description": "MCP server for TouchQue — gives AI coding assistants (Claude, Cursor, …) accurate, up-to-date TouchQue SDK docs, types and an integration validator so they don't guess at the API.",
  "main": "index.js",
  "bin": {
    "touchque-mcp-server": "index.js"
  },
  "files": [
    "index.js",
    "bundled"
  ],
